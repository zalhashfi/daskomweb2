VITE_IMAGEKIT_PUBLIC_KEY="${IMAGEKIT_PUBLIC_KEY}"
VITE_IMAGEKIT_ENDPOINT_URL="${IMAGEKIT_ENDPOINT_URL}"
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
SANCTUM_STATEFUL_DOMAINS=localhost

# ---------------------------------------------------------------------------
# AI grading (see config/ai.php)
#
# Everything is inert until BOTH ai_enabled and allow_external_payload are
# true on the active ai_configs row and the provider policy has been verified
# with `php artisan ai:verify-provider --confirm-paid-no-training`.
# ---------------------------------------------------------------------------
AI_BASE_URL=http://127.0.0.1:20128
AI_API_KEY=
AI_CHAT_MODEL=gemini/gemini-flash
AI_CHAT_MODEL_VERSION=
AI_EMBED_MODEL=gemini/gemini-embedding-001
AI_EMBED_DIMENSION=3072
AI_BUDGET_TOKENS_PER_MODUL=500000

# Redis-backed snapshot cache. Required: config/cache.php defaults to redis for
# snapshot_store, and an empty value breaks boot with "Class Redis not found".
CACHE_SNAPSHOT_STORE=redis
